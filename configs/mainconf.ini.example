[DATA]
# Source to pull data from: READSB, OPENSKY, or RpdADSBX (RapidAPI ADSBX)
# Default: READSB
SOURCE = READSB
# Default amount of time (mins) after data loss to trigger a landing when under 10k ft
DATA_LOSS_MINS = 5
# Timezone for console and logs, list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ = UTC


[READSB]
# READSB 
# API KEY if required 
API_KEY = 
# Full path to readsb all.json endpoint 
ENDPOINT = http://127.0.0.1:8080/data/aircraft.json
# URL to pull Resolution Advisory (ACAS) history from readsb
RA_HOST = https://globe.theairtraffic.com

[OPENSKY]
# OpenSky Network Source (https://opensky-network.org)
# Leave as None for anonymous access (lower rate limits)
USERNAME = None
PASSWORD = None

[RpdADSBX]
# RapidAPI ADS-B Exchange Source
API_KEY = 
API_VERSION = 2

[SLEEP]
# Define the delay interval in seconds between each data request.
SLEEPSEC = 60

[AIRPORT]
# Global default airport types to filter for (can be overridden per-plane)
TYPES = small_airport,medium_airport,large_airport

[MAP]
# Map generation options: fsm (Flight Static Maps) or TAR1090 (screenshot) or GOOGLESTATICMAP (Google Static Maps)
OPTION = fsm

# TAR1090 Screenshot Configuration
# The base URL of the tar1090 instance to screenshot (e.g., globe.theairtraffic.com)
TAR1090_URL = https://globe.theairtraffic.com
# URL or local file path to an icon to display in the map credits (bottom right)
CREDIT_IMG_URL = https://theairtraffic.com/images/favicon.png
# The text branding to display in the map credits (bottom right)
TEXT_CREDIT = TheAirtraffic.com
# Path to a logo to display in the center map when it fails to load screenshot/map (fallback)
ERROR_LOGO = ./dependencies/GCLogo.png

[GOOGLE]
# DEPRECATED
API_KEY = 

[TFRS]
# Temporary Flight Restrictions (TFR) Service
URL = http://127.0.0.1:5000/detailed_all
ENABLE = FALSE

[HTTP_SERVE]
# Base URL where serve_images.py or your reverse proxy is reachable. 
# Required for services that need public image URLs (Instagram, Threads)
IMAGE_URL = 


[DISCORD]
# Global Discord settings for System/Error notifications
ENABLE = FALSE
USERNAME = plane-notify
URL = 
# Optional: URL for important system/warning messages
WARNING_URL = 
# Optional: Role ID to mention in alerts
ROLE_ID = 

[REDDIT]
# Global Reddit Application Keys
ENABLE = FALSE
CLIENT_ID = 
CLIENT_SECRET = 
USER_AGENT = plane-notify
USERNAME = 
PASSWORD = 
# Note: SUBREDDIT is configured per-plane in the plane config file.

[DB]
# PostgreSQL database for flight tracking history, and dependencies
ENABLE = FALSE
HOST = localhost
PORT = 5432
USERNAME = 
PASSWORD = 
DATABASE = tracking
